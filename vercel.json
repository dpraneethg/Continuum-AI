{
  "version": 2,
  "framework": null,
  "installCommand": "npm install --ignore-scripts",
  "buildCommand": "",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "web/**"
    }
  },
  "routes": [
    { "src": "/vendor/(.*)", "dest": "/web/vendor/$1" },
    { "src": "/(favicon\\.svg|og-image\\.png|styles\\.css|theme\\.css|site\\.css|demo\\.css)$", "dest": "/web/$1" },
    { "src": "/(theme-init\\.js|ui\\.js|client\\.js|auth-ui\\.js|form-kit\\.js|toast\\.js|palette\\.js|fx\\.js|scene\\.js|pages\\.js|team\\.js|staff-account\\.js|staff-access-ui\\.js|data-sources-ui\\.js|knowledge-import-ui\\.js|connector-ui\\.js|operator\\.js|tour\\.js|demo\\.js|workspace-control\\.js|chatbot-config\\.js)$", "dest": "/web/$1" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(robots\\.txt|sitemap\\.xml)$", "dest": "/api/index.js" },
    { "src": "/(|about|services|pricing|book-a-session|style-guide|team|operator|desk|demo|privacy|terms|security)$", "dest": "/api/index.js" }
  ]
}
